# Towline remote MCP gateway, generated by 'towline remote deploy'.
# Secrets come from the environment (TOWLINE_GATEWAY_CONFIG, TUNNEL_TOKEN),
# never from this file.
services:
  gateway:
    image: {{.Image}}
    command: ["gateway"]
    restart: unless-stopped
    environment:
      TOWLINE_GATEWAY_CONFIG: ${TOWLINE_GATEWAY_CONFIG}
    volumes:
      - gateway-data:/data
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # Bounds what a misbehaving client can make the gateway hold.
    mem_limit: 512m
    pids_limit: 256
{{- if .HostGateway}}
    extra_hosts:
      - host.docker.internal:host-gateway
{{- end}}
{{- if .Port}}
    ports:
      - "{{.Port}}:8080"
{{- end}}
{{- if .Tunnel}}

  # Cloudflare Tunnel: outbound-only, so the gateway is reachable behind
  # NAT, CGNAT or double NAT with no port forwarding. In the Cloudflare
  # dashboard, route the tunnel's public hostname to http://gateway:8080.
  cloudflared:
    image: {{.CloudflaredImage}}
    command: ["tunnel", "--no-autoupdate", "run"]
    restart: unless-stopped
    environment:
      TUNNEL_TOKEN: ${TUNNEL_TOKEN}
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    depends_on:
      - gateway
{{- end}}

volumes:
  gateway-data:
