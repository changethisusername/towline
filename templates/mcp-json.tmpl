{
  "mcpServers": {
    "towline-{{.Tier}}": {
      "type": "stdio",
      "command": "{{.MCPBinaryPath}}",
      "args": [
        "-server", "{{.PortainerURL}}",
        "-token", "{{.APIToken}}",
        "-stack", "{{.StackName}}",
        "-tier", "{{.Tier}}",
        "-disable-version-check",
        "-skip-tls-verify"
      ]
    }
  }
}
