{
  "mcpServers": {
    "towline-{{.Tier}}": {
      "type": "stdio",
      "command": {{json .MCPBinaryPath}},
      "args": [
        "-server", {{json .PortainerURL}},
        "-stack", {{json .StackName}},
        "-tier", {{json .Tier}},
        "-disable-version-check"{{if .SkipTLSVerify}},
        "-skip-tls-verify"{{end}}{{if and (eq .Tier "prod") .ApprovalWebhook}},
        "-approval-webhook", {{json .ApprovalWebhook}}{{end}}
      ],
      "env": {
        "TOWLINE_PORTAINER_TOKEN": {{json .APIToken}}
      }
    }
  }
}
